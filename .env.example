# Copy to .env and fill in. Never commit .env.

# ── Database (required) ──────────────────────────────────────────────────
# Postgres connection string. On Vercel this is injected automatically by the
# Neon marketplace integration — don't set it by hand there.
# Locally, use a Neon dev branch so dev and production run the same engine.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Absolute site URL — used for canonicals, og:image and sitemap URLs.
# Must be the real domain in production or the SEO metadata will be wrong.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Admin panel (required for /admin) ────────────────────────────────────
ADMIN_PASSWORD=""
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# ── Telegram lead notifications (optional) ───────────────────────────────
# 1. Message @BotFather → /newbot → copy the token
# 2. Send your bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy result[0].message.chat.id
# Leave blank to disable — leads then only appear in /admin.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
